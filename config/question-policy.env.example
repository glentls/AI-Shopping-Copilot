# Copy these exports into the environment that starts the agent, or run:
#   source config/question-policy.env.example

# Initial value of asking "anything else that matters?". Concrete questions
# normally score between zero and five; eight gives the first broad question a
# modest lead without returning to the old, dominant value of twenty.
export TJ_OPEN_QUESTION_BASELINE=8.0

# Multiplicative discount after each answered open-ended question.
export TJ_OPEN_QUESTION_DECAY=0.8

# Number of new structured facts expected from a highly productive answer.
export TJ_OPEN_QUESTION_EXPECTED_YIELD=2.0

# Hard conversational guardrails for one intent.
export TJ_OPEN_QUESTION_MAX_CONSECUTIVE=2
export TJ_OPEN_QUESTION_ZERO_YIELD_PATIENCE=2
export TJ_OPEN_QUESTION_DECLINE_PATIENCE=2
